{
  "manifest_version": 3,
  "name": "Joblens",
  "version": "1.0.2",
  "description": "Analyze job postings and get personalized interview prep, fit scores, and outreach drafts for your job search.",
  "homepage_url": "https://joblens-production-928c.up.railway.app/privacy",
  "action": {
    "default_icon": "Insightlens.png",
    "default_title": "Joblens"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://joblens-production-928c.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://www.indeed.com/*",
        "https://*.notion.site/*"
      ],
      "js": ["config.js", "profile.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Insightlens.png"],
      "matches": [
        "https://www.linkedin.com/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://www.indeed.com/*",
        "https://*.notion.site/*"
      ]
    }
  ]
}
