OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed browser origins.
# Get your extension ID from chrome://extensions after loading unpacked.
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID,http://localhost:8006

# Max analyze requests per IP per minute.
RATE_LIMIT_PER_MINUTE=10

# Port used when running locally (uvicorn --port 8006 main:app)
PORT=8006
